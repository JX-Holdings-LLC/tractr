{
  "id": "npc-rook",
  "name": "Rook the Wanderer",
  "visual": {
    "assetId": "art-npc-rook"
  },
  "x": 13,
  "y": 11,
  "sceneId": "scene-square",
  "dialogue": [
    {
      "id": "dlg-rook",
      "npcId": "npc-rook",
      "text": "Ah, a new face. I collect stories, old boots and the occasional shiny rock. In trade, I tell people where things are buried.",
      "options": [
        {
          "text": "Pip wants to know about the map.",
          "nextDialogueId": "dlg-rook-map",
          "requiresFlag": "pip-asked"
        },
        {
          "text": "Tell me a story.",
          "nextDialogueId": "dlg-rook-story"
        },
        {
          "text": "Safe travels."
        }
      ]
    },
    {
      "id": "dlg-rook-map",
      "npcId": "npc-rook",
      "text": "The X is under the old well. Not the treasure, mind. The treasure is that he'll spend all afternoon looking. Tell him I said so.",
      "options": [
        {
          "text": "Ha. I'll tell him.",
          "eventFlag": "rook-told"
        }
      ],
      "expression": "happy"
    },
    {
      "id": "dlg-rook-story",
      "npcId": "npc-rook",
      "text": "Long ago a farmer planted a melon under a full moon, and it never stopped glowing. They say every moonmelon since is a cutting of that first light.",
      "options": [
        {
          "text": "That's lovely."
        }
      ]
    }
  ],
  "canMove": true,
  "movePattern": "wander",
  "wanderRadius": 3,
