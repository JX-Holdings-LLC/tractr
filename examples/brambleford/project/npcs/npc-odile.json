  "sceneId": "scene-square",
  "dialogue": [
    {
      "id": "dlg-odile",
      "npcId": "npc-odile",
      "text": "Welcome to Brambleford, dear. Your Aunt Wren kept Thistledown Farm blooming for forty years. We'd all be so glad to see it green again.",
      "options": [
        {
          "text": "I'll do my best.",
          "giveItem": "seed-emberroot",
          "giveItemQuantity": 5,
          "once": true
        },
        {
          "text": "What happened to the Lantern Night?",
          "nextDialogueId": "dlg-odile-lanterns"
        },
        {
          "text": "Just saying hello!"
        }
      ],
      "expression": "happy"
    },
    {
      "id": "dlg-odile-lanterns",
      "npcId": "npc-odile",
      "text": "Every spring we lit the lanterns with moonmelons from Wren's field. Then the mill went quiet, the seeds ran out, and... well. Some lights take a while to come back.",
      "options": [
        {
          "text": "Maybe I can help."
        }
      ],
      "expression": "sad"
    }
  ],
