  "appearance": "elder",
  "lines": [
    {
      "text": "Good morning! The square always looks brightest before the bakery smoke rolls in.",
      "conditions": [
        {
          "type": "timeOfDay",
          "minMinute": 360,
          "maxMinute": 660
        }
      ],
      "expression": "happy"
    },
    {
      "text": "Rain again. Wren used to say the emberroot drinks it and laughs.",
      "conditions": [
        {
          "type": "weather",
          "weatherIds": [
            "rain",
            "storm"
          ]
        }
      ]
    },
    {
      "text": "Five emberroot, and the soil will remember what it's for. That's how it starts.",
      "conditions": [
        {
          "type": "questStatus",
          "questId": "quest-roots",
          "status": "active"
        }
      ]
    },
    {
      "text": "Bram's been grumbling at that mill for a year. Perhaps he'd let you help.",
      "conditions": [
        {
          "type": "questStatus",
          "questId": "quest-roots",
          "status": "completed"
        },
        {
          "type": "questStatus",
          "questId": "quest-silent-mill",
          "status": "not-started"
        }
      ]
    },
    {
      "text": "Moonmelons! Three, and I'll have the lanterns out of the attic before you can blink.",
      "conditions": [
        {
          "type": "questStatus",
          "questId": "quest-lantern-night",
          "status": "active"
        }
      ],
      "expression": "happy"
    },
    {
      "text": "Look at it glow. Thank you, truly.",
      "conditions": [
        {
          "type": "flag",
          "flag": "lanterns-lit",
          "value": true
        }
      ],
      "expression": "happy",
      "weight": 3
    },
    {
      "text": "Evenings are long without the lanterns. I keep a candle in my window, just in case.",
      "conditions": [
