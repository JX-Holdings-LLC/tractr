<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Tractr.App.Controls"
             x:Class="Tractr.App.App"
             Name="Tractr"
             RequestedThemeVariant="Light">

  <!-- Tractr's "Seed Catalog" look (docs/brand/STYLE.md): warm paper, a few flat printing inks, a red
       tractor. Colours are named after the inks. The older Farm* resource names stay (the views
       use them) and now point at the Seed Catalog palette: Primary is Barn Red, Secondary Field
       Green, Accent Mustard. -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- Inks -->
      <Color x:Key="PaperColor">#F2E5C6</Color>
      <Color x:Key="LightPaperColor">#F7EED6</Color>
      <Color x:Key="SandColor">#E9DAB6</Color>
      <Color x:Key="BarnRedColor">#B5332A</Color>
      <Color x:Key="BarnRedHoverColor">#9E2B23</Color>
      <Color x:Key="HubRedColor">#8F2A22</Color>
      <Color x:Key="FieldGreenColor">#4F6B3A</Color>
      <Color x:Key="FieldGreenHoverColor">#5E7C45</Color>
      <Color x:Key="SproutColor">#7D9440</Color>
      <Color x:Key="MustardColor">#E3A83A</Color>
      <Color x:Key="MustardHoverColor">#ECBA55</Color>
      <Color x:Key="SunColor">#F0C35E</Color>
      <Color x:Key="WheatColor">#C58F2C</Color>
      <Color x:Key="PondColor">#7FA6A6</Color>
      <Color x:Key="InkColor">#3A2A1E</Color>
      <Color x:Key="SaddleColor">#6D5A40</Color>
      <Color x:Key="KraftColor">#C9B48A</Color>

      <!-- Roles. Foreground on Paper is 11:1, Saddle (small text) 5.3:1, Barn Red and Field Green 4.8:1. -->
      <Color x:Key="FarmBackgroundColor">#F2E5C6</Color>
      <Color x:Key="FarmCardColor">#E9DAB6</Color>
      <Color x:Key="FarmSurfaceColor">#F7EED6</Color>
      <Color x:Key="FarmForegroundColor">#3A2A1E</Color>
      <Color x:Key="FarmPrimaryColor">#B5332A</Color>
      <Color x:Key="FarmPrimaryHoverColor">#9E2B23</Color>
      <Color x:Key="FarmSecondaryColor">#4F6B3A</Color>
      <Color x:Key="FarmSecondaryHoverColor">#5E7C45</Color>
      <Color x:Key="FarmAccentColor">#E3A83A</Color>
      <Color x:Key="FarmMutedColor">#E4D5B0</Color>
      <Color x:Key="FarmMutedForegroundColor">#6D5A40</Color>
      <Color x:Key="FarmBorderColor">#C9B48A</Color>
      <!-- Errors use Hub Red (the tractor's darker red), always with an icon or a label, so they are
           not confused with Barn Red primary actions. -->
      <Color x:Key="FarmDestructiveColor">#8F2A22</Color>

      <SolidColorBrush x:Key="FarmBackgroundBrush" Color="{StaticResource FarmBackgroundColor}" />
      <SolidColorBrush x:Key="FarmCardBrush" Color="{StaticResource FarmCardColor}" />
      <SolidColorBrush x:Key="FarmSurfaceBrush" Color="{StaticResource FarmSurfaceColor}" />
      <SolidColorBrush x:Key="FarmForegroundBrush" Color="{StaticResource FarmForegroundColor}" />
      <SolidColorBrush x:Key="FarmPrimaryBrush" Color="{StaticResource FarmPrimaryColor}" />
      <SolidColorBrush x:Key="FarmSecondaryBrush" Color="{StaticResource FarmSecondaryColor}" />
      <SolidColorBrush x:Key="FarmAccentBrush" Color="{StaticResource FarmAccentColor}" />
      <SolidColorBrush x:Key="FarmMutedBrush" Color="{StaticResource FarmMutedColor}" />
      <SolidColorBrush x:Key="FarmMutedForegroundBrush" Color="{StaticResource FarmMutedForegroundColor}" />
      <SolidColorBrush x:Key="FarmBorderBrush" Color="{StaticResource FarmBorderColor}" />
      <SolidColorBrush x:Key="FarmDestructiveBrush" Color="{StaticResource FarmDestructiveColor}" />
      <SolidColorBrush x:Key="FieldGreenBrush" Color="{StaticResource FieldGreenColor}" />
      <SolidColorBrush x:Key="MustardBrush" Color="{StaticResource MustardColor}" />
      <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="FarmCodeBackgroundBrush" Color="#EBDDB9" />
      <!-- Status tints: flat washes of the inks on Paper. Success is green, update is sun yellow,
           warning is wheat, error is Hub Red, information is Pond. -->
      <SolidColorBrush x:Key="FarmSuccessTintBrush" Color="#DEE3C3" />
      <SolidColorBrush x:Key="FarmUpdateTintBrush" Color="#F6E5AE" />
      <SolidColorBrush x:Key="FarmWarningTintBrush" Color="#F1D9A2" />
      <SolidColorBrush x:Key="FarmErrorTintBrush" Color="#F0D3C3" />
      <SolidColorBrush x:Key="FarmInfoTintBrush" Color="#D9E4DA" />
      <SolidColorBrush x:Key="FarmSuccessBorderBrush" Color="#9DAE7B" />
      <SolidColorBrush x:Key="FarmUpdateBorderBrush" Color="#E3A83A" />
      <SolidColorBrush x:Key="FarmWarningBorderBrush" Color="#C58F2C" />
      <SolidColorBrush x:Key="FarmErrorBorderBrush" Color="#8F2A22" />
      <!-- Paper grain, a finish for large fields only (never under small icons or logos). -->
      <ImageBrush x:Key="PaperGrainBrush" Source="avares://Tractr/Assets/paper-grain.png"
                  TileMode="Tile" DestinationRect="0,0,256,256" />

      <!-- Four type voices (docs/brand/STYLE.md). Inter stays behind them for glyphs they lack. -->
      <FontFamily x:Key="DisplayFont">avares://Tractr/Assets/Fonts#Alfa Slab One, fonts:Inter#Inter</FontFamily>
      <FontFamily x:Key="ScriptFont">avares://Tractr/Assets/Fonts#Lobster, fonts:Inter#Inter</FontFamily>
      <FontFamily x:Key="LabelFont">avares://Tractr/Assets/Fonts#Oswald, fonts:Inter#Inter</FontFamily>
      <FontFamily x:Key="BodyFont">avares://Tractr/Assets/Fonts#Courier Prime, fonts:Inter#Inter</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">avares://Tractr/Assets/Fonts#Courier Prime, fonts:Inter#Inter</FontFamily>
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

      <!-- Fluent control colours, mapped to the inks. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#F7EED6" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F6E7BC" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E9D6A6" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#EADFC3" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C9B48A" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B5332A" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#9E2B23" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#D8CBA6" />
      <SolidColorBrush x:Key="ButtonForeground" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8C7C5E" />

      <SolidColorBrush x:Key="AccentButtonBackground" Color="#B5332A" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#9E2B23" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8F2A22" />
      <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#D9B7A6" />
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#B5332A" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#9E2B23" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#8F2A22" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#D9B7A6" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#F2E5C6" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#F2E5C6" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#F2E5C6" />
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#F7EED6" />

      <SolidColorBrush x:Key="ToggleButtonBackground" Color="#F7EED6" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#F6E7BC" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#E9D6A6" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E3A83A" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#ECBA55" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D79A2B" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#C9B48A" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#B5332A" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToggleButtonForeground" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#3A2A1E" />

      <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#B5332A" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#8F2A22" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#6E1D17" />

      <SolidColorBrush x:Key="TextControlBackground" Color="#FBF5E3" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FBF5E3" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFAEC" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#C9B48A" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#6D5A40" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B5332A" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#3A2A1E" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6D5A40" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#E3A83A" />

      <SolidColorBrush x:Key="ComboBoxBackground" Color="#FBF5E3" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FBF5E3" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F6E7BC" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#C9B48A" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#6D5A40" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#B5332A" />
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#B5332A" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#F6E7BC" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E3A83A" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#ECBA55" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#3A2A1E" />

      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F7EED6" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#C9B48A" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#E3A83A" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#3A2A1E" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#D79A2B" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#3A2A1E" />

      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#4F6B3A" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#5E7C45" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#3D5530" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#4F6B3A" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#5E7C45" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#3D5530" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#FBF5E3" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#6D5A40" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#F2E5C6" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#F2E5C6" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#F2E5C6" />

      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#4F6B3A" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#5E7C45" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#3D5530" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#4F6B3A" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#5E7C45" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#3D5530" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="#FBF5E3" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#6D5A40" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#F2E5C6" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStroke" Color="#F2E5C6" />

      <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#6D5A40" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#3A2A1E" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="#3A2A1E" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#B5332A" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#9E2B23" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="#9E2B23" />
      <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#B5332A" />
      <x:Double x:Key="TabItemHeaderFontSize">15</x:Double>
      <FontWeight x:Key="TabItemHeaderThemeFontWeight">Bold</FontWeight>

      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F7EED6" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#F6E7BC" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#E9D6A6" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#C9B48A" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#B5332A" />
      <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#C9B48A" />

      <SolidColorBrush x:Key="ToolTipBackground" Color="#3A2A1E" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#F2E5C6" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3A2A1E" />

      <!-- Icons (Material Design Icons, Apache-2.0): filled silhouettes in palette colours. -->
      <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
      <StreamGeometry x:Key="IconPencil">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
      <StreamGeometry x:Key="IconDownload">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
      <StreamGeometry x:Key="IconCheckCircle">M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z</StreamGeometry>
      <StreamGeometry x:Key="IconAlertCircle">M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
      <StreamGeometry x:Key="IconInfo">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
      <StreamGeometry x:Key="IconGift">M22,12V20A2,2 0 0,1 20,22H4A2,2 0 0,1 2,20V12A1,1 0 0,1 1,11V8A2,2 0 0,1 3,6H6.17C6.06,5.69 6,5.35 6,5A3,3 0 0,1 9,2C10,2 10.88,2.5 11.43,3.24V3.23L12,4L12.57,3.23V3.24C13.12,2.5 14,2 15,2A3,3 0 0,1 18,5C18,5.35 17.94,5.69 17.83,6H21A2,2 0 0,1 23,8V11A1,1 0 0,1 22,12M4,20H11V12H4V20M20,20V12H13V20H20M9,4A1,1 0 0,0 8,5A1,1 0 0,0 9,6A1,1 0 0,0 10,5A1,1 0 0,0 9,4M15,4A1,1 0 0,0 14,5A1,1 0 0,0 15,6A1,1 0 0,0 16,5A1,1 0 0,0 15,4M3,8V10H11V8H3M13,8V10H21V8H13Z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
      <StreamGeometry x:Key="IconAccount">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</StreamGeometry>
      <StreamGeometry x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</StreamGeometry>
      <StreamGeometry x:Key="IconPackage">M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15Z</StreamGeometry>
      <StreamGeometry x:Key="IconHammer">M2,19.63L13.43,8.2L12.72,7.5L14.14,6.07L12,3.89C13.2,2.7 15.09,2.7 16.27,3.89L19.87,7.5L18.45,8.91H21.29L22,9.62L18.45,13.21L17.74,12.5V9.62L16.27,11.04L15.56,10.33L4.13,21.76L2,19.63Z</StreamGeometry>
      <StreamGeometry x:Key="IconStore">M12,18H6V14H12M21,14V12L20,7H4L3,12V14H4V20H14V14H18V20H20V14M20,4H4V6H20V4Z</StreamGeometry>
      <StreamGeometry x:Key="IconMoon">M12,3C7.03,3 3,7.03 3,12C3,16.97 7.03,21 12,21C16.97,21 21,16.97 21,12C21,11.54 20.96,11.08 20.9,10.64C19.92,12.01 18.32,12.9 16.5,12.9C13.52,12.9 11.1,10.48 11.1,7.5C11.1,5.69 11.99,4.08 13.36,3.1C12.92,3.04 12.46,3 12,3Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
      <StreamGeometry x:Key="IconDelete">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
      <StreamGeometry x:Key="IconUndo">M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z</StreamGeometry>
      <StreamGeometry x:Key="IconRedo">M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z</StreamGeometry>
      <StreamGeometry x:Key="IconMap">M15,19L9,16.89V5L15,7.11M20.5,3C20.44,3 20.39,3 20.34,3L15,5.1L9,3L3.36,4.9C3.15,4.97 3,5.15 3,5.38V20.5A0.5,0.5 0 0,0 3.5,21C3.55,21 3.61,21 3.66,20.97L9,18.9L15,21L20.64,19.1C20.85,19 21,18.85 21,18.62V3.5A0.5,0.5 0 0,0 20.5,3Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FFB5332A" RegionColor="#FFF2E5C6" BaseHigh="#FF3A2A1E"
                               AltHigh="#FFF7EED6" ErrorText="#FF8F2A22" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <StyleInclude Source="avares://Tractr/Game/GameStyles.axaml" />

    <!-- The window is the canvas: Paper with a very fine grain. Text sits on Light paper cards. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource PaperGrainBrush}" />
      <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Typography. h1 is Alfa Slab One (screen titles, big numbers); h2/h3 are Oswald caps
         (KickerText draws them in capitals); Courier Prime is the body. -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="2.2" />
      <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource FarmMutedForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.script">
      <Setter Property="FontFamily" Value="{StaticResource ScriptFont}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource FarmMutedForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Surfaces: Light paper cards on Paper, Kraft hairlines, soft 10 px corners, no soft shadows. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <!-- The header band: Light paper under a Barn Red rule, like a catalog page's masthead. -->
    <Style Selector="Border.header">
      <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
    </Style>
    <Style Selector="Border.placeholder">
      <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{StaticResource FarmCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="16,5" />
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="{StaticResource FarmCardBrush}" />
    </Style>

    <!-- Buttons are Oswald (label voice). "accent" is the one primary action in Barn Red,
         "secondary" is Field Green, "badge" is a Mustard tag. -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="Button.large">
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{StaticResource FarmSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmSecondaryBrush}" />
      <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FarmSecondaryHoverColor}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmSecondaryHoverColor}" />
      <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3D5530" />
      <Setter Property="BorderBrush" Value="#3D5530" />
      <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style Selector="Button.badge">
      <Setter Property="Background" Value="{StaticResource FarmAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="Button.badge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MustardHoverColor}" />
      <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
      <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="PathIcon.button-icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- Lists: Light paper, a Kraft hairline, and Mustard for the selection (always with Ink text). -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F6E7BC" />
      <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FarmAccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
    </Style>

    <!-- Tabs: Oswald, with a Barn Red rule under the page you are on. -->
    <Style Selector="TabItem">
      <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- Update Center status card tones: success green, update sun, warning wheat, error Hub Red.
         Every tone also has its own icon, so colour is never the only signal. -->
    <Style Selector="Border.status">
      <Setter Property="BorderThickness" Value="1,1,1,1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    </Style>
    <Style Selector="Border.status.success">
      <Setter Property="Background" Value="{StaticResource FarmSuccessTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmSuccessBorderBrush}" />
    </Style>
    <Style Selector="Border.status.update">
      <Setter Property="Background" Value="{StaticResource FarmUpdateTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmUpdateBorderBrush}" />
    </Style>
    <Style Selector="Border.status.warning">
      <Setter Property="Background" Value="{StaticResource FarmWarningTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.status.error">
      <Setter Property="Background" Value="{StaticResource FarmErrorTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource FarmErrorBorderBrush}" />
    </Style>
    <Style Selector="PathIcon.status-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="{StaticResource FarmMutedForegroundBrush}" />
    </Style>
    <Style Selector="Border.success PathIcon.status-icon">
      <Setter Property="Foreground" Value="{StaticResource FieldGreenBrush}" />
    </Style>
    <Style Selector="Border.update PathIcon.status-icon">
      <Setter Property="Foreground" Value="#A9741C" />
    </Style>
    <Style Selector="Border.warning PathIcon.status-icon">
      <Setter Property="Foreground" Value="#A9741C" />
    </Style>
    <Style Selector="Border.error PathIcon.status-icon">
      <Setter Property="Foreground" Value="{StaticResource FarmDestructiveBrush}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource FieldGreenBrush}" />
      <Setter Property="Background" Value="{StaticResource FarmMutedBrush}" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- Markdown (controls:MarkdownView) -->
    <Style Selector="controls|MarkdownView SelectableTextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="SelectionBrush" Value="#66E3A83A" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h1">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="LineHeight" Value="26" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h2">
      <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h3">
      <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="TextBlock.md-marker">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.md-quote">
      <Setter Property="BorderBrush" Value="{StaticResource FarmAccentBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="SelectableTextBlock.md-quote-text">
      <Setter Property="Foreground" Value="{StaticResource FarmMutedForegroundBrush}" />
    </Style>
    <Style Selector="Border.md-code">
      <Setter Property="Background" Value="{StaticResource FarmCodeBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="SelectableTextBlock.md-code-text">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </Application.Styles>
</Application>
