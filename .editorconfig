root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,axaml,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Fantomas uses this width for F# layout; C# treats it as a review guideline because
# dotnet format does not wrap long expressions. Rust uses max_width = 120.
# CI checks dotnet format (C#), Fantomas (F#), and text-style.py (all text).
[*.{cs,fs,fsx,fsi}]
max_line_length = 160
