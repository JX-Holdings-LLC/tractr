{
  "schemaVersion": 1,
  "bumpPolicy": "every-main-change",
  "apps": {
    "tractr": {
      "tagPrefix": "v",
      "paths": [
        "**"
      ],
      "versionFiles": [
        {
          "path": "Cargo.toml",
          "format": "text",
          "pattern": "^version = \"(?<version>[^\"]+)\"$"
        },
        {
          "path": "Directory.Build.props",
          "format": "text",
          "pattern": "<Version Condition=\"[^\\r\\n]*?\">(?<version>[^<]+)</Version>"
        }
      ],
      "notes": "CHANGELOG.md",
      "notesSection": true,
      "assets": [
        "Tractr-{version}-full.nupkg",
        "Tractr-win-Portable.zip",
        "Tractr-win-Setup.exe",
        "releases.win.json",
        "Tractr-{version}-linux-x64-full.nupkg",
        "releases.linux-x64.json",
        "Tractr-linux-x64.AppImage",
        "Tractr-{version}-osx-x64-full.nupkg",
        "releases.osx-x64.json",
        "Tractr-osx-x64-Portable.zip",
        "Tractr-{version}-osx-arm64-full.nupkg",
        "releases.osx-arm64.json",
        "Tractr-osx-arm64-Portable.zip",
        "DOWNLOADS.md"
      ],
      "security": "standard",
      "checksumFile": "SHA256SUMS",
      "notesAsset": "DOWNLOADS.md",
      "legacyLatest": true,
      "optionalAssets": [
        {
          "pattern": "^Tractr-{version}-delta\\.nupkg$",
          "min": 0,
          "max": 1
        }
      ]
    }
  }
}
