<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Tractr.App.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tractr.Updates/Tractr.Updates.csproj" />
    <ProjectReference Include="../../src/Tractr.App/Tractr.App.csproj" />
    <ProjectReference Include="../../src/FarmEngine.Interop/FarmEngine.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/audio/tone.ogg" Link="Fixtures/audio/tone.ogg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/projects/fixture-project.json" Link="Fixtures/fixture-project.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/projects/demo-mod.json" Link="Fixtures/demo-mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/projects/lantern-night-mod.json" Link="Fixtures/lantern-night-mod.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- A tiny Windows program with the player template's placeholder resources (see that folder's build.sh). -->
    <None Include="../FarmEngine.Export.Tests/Fixtures/pe/player-fixture.exe" Link="Fixtures/player-fixture.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
